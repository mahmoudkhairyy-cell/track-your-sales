# قاعدة PostgreSQL. استخدم رابط قاعدة البيانات الخاصة ببيئة التشغيل.
# بيانات نموذجية فقط — حط القيم الفعلية في إعدادات الاستضافة السرية، مش في الكود.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# مساحة واحدة. وضع sessions ما زال scaffolding.
AUTH_MODE=single-workspace

# false للاستخدام المحلي فقط. على أي استضافة عامة، خليها true.
PUBLIC_DEPLOYMENT=false

# اسم بوابة الحماية (مش اسم الموظف في قاعدة البيانات).
WORKSPACE_USERNAME=mahmoud

# مطلوب عند النشر العام: كلمة عشوائية فريدة، 24 حرف على الأقل، 256 بحد أقصى.
# متكتبهاش في رابط الموقع أو في NEXT_PUBLIC_* أو في README.
# على الكمبيوتر المحلي فقط ممكن تسيبها فاضية.
WORKSPACE_PASSWORD=
