# قاعدة PostgreSQL. استخدم رابط الاستضافة عند النشر، مش قاعدة المعاينة المحلية.
# بيانات نموذجية فقط — حط القيم الفعلية في إعدادات الاستضافة السرية، مش في الكود.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# مساحة واحدة. وضع sessions ما زال scaffolding، ومش مطلوب للنشر الخاص بكلمة حماية.
AUTH_MODE=single-workspace

# false للاستخدام المحلي فقط. على Vercel الحماية إجبارية حتى لو القيمة false.
# على أي استضافة عامة تانية، خليها true.
PUBLIC_DEPLOYMENT=false

# اسم بوابة الحماية (مش اسم الموظف في قاعدة البيانات).
WORKSPACE_USERNAME=mahmoud

# مطلوب عند النشر: كلمة عشوائية فريدة، 24 حرف على الأقل، 256 بحد أقصى.
# متكتبهاش في رابط الموقع أو في NEXT_PUBLIC_* أو في README.
# على الكمبيوتر المحلي فقط ممكن تسيبها فاضية.
WORKSPACE_PASSWORD=
